# --- core ---
DATABASE_URL="postgresql://leads:leads@localhost:5432/leads"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="generate-with: openssl rand -base64 32"
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Run the BullMQ processors inside the API process (dev convenience).
# In production run them separately: node dist/worker.js
INLINE_WORKER=1

# Milliseconds per "day" for follow-up waits. Real day by default;
# set e.g. 60000 to watch a whole sequence play out in minutes.
# DAY_MS=86400000

# --- integrations (all optional: the app runs in demo mode without them) ---
APOLLO_API_KEY=""
HUNTER_API_KEY=""
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="SaaSquatch Leads"
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.6-flash"
GROQ_API_KEY=""
ZEROBOUNCE_API_KEY=""
